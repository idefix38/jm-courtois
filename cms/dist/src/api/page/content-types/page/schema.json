{
    "kind": "collectionType",
    "collectionName": "pages",
    "info": {
        "singularName": "page",
        "pluralName": "pages",
        "displayName": "Page"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "Titre": {
            "type": "string",
            "required": true
        },
        "Slug": {
            "type": "uid",
            "targetField": "Titre",
            "required": true
        },
        "Contenu": {
            "type": "dynamiczone",
            "components": [
                "page-builder.hero",
                "page-builder.texte-image"
            ]
        },
        "Seo": {
            "type": "component",
            "component": "shared.seo",
            "repeatable": false
        }
    }
}
