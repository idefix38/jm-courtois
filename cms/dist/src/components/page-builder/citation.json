{
    "collectionName": "components_page_builder_citations",
    "info": {
        "displayName": "Citation",
        "icon": "quote",
        "description": "Bloc citation sur fond nuage"
    },
    "options": {},
    "attributes": {
        "Titre": {
            "type": "string"
        },
        "Description": {
            "type": "customField",
            "customField": "plugin::ckeditor5.CKEditor",
            "options": {
                "preset": "defaultHtml"
            },
            "required": true
        },
        "Bouton": {
            "type": "component",
            "component": "component.bouton-cta",
            "repeatable": false
        },
        "Style": {
            "type": "enumeration",
            "enum": [
                "Nuages",
                "Cerf-volant",
                "Herbes",
                "Uni",
                "Livre"
            ],
            "default": "Nuages",
            "required": true
        }
    }
}
