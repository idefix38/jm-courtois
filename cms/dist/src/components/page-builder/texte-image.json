{
    "collectionName": "components_page_builder_texte_images",
    "info": {
        "displayName": "TexteImage",
        "icon": "layout",
        "description": "Bloc texte avec image optionnelle et CTA"
    },
    "options": {},
    "attributes": {
        "Titre": {
            "type": "string",
            "required": true
        },
        "Description": {
            "type": "richtext"
        },
        "Image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": ["images"]
        },
        "PositionImage": {
            "type": "enumeration",
            "enum": ["Gauche", "Droite"],
            "default": "Droite"
        },
        "Cta": {
            "type": "component",
            "component": "component.bouton-cta",
            "repeatable": false
        }
    }
}
