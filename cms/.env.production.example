# ======================
# CMS Strapi — production (cms/.env.production, jamais commité)
# ======================

# Générer avec : node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Doit être strictement identique à la valeur utilisée dans frontend/.env.production
PREVIEW_SECRET=

# URL publique du frontend en production, utilisée pour le CORS et le lien de preview
CLIENT_URL=https://www.jm-courtois.com

# URL publique du CMS (derrière le reverse-proxy en place sur le serveur, TLS terminé en amont)
PUBLIC_URL=https://cms.jm-courtois.com
IS_PROXIED=true
