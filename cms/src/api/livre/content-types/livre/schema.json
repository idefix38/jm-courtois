{
  "kind": "collectionType",
  "collectionName": "livres",
  "info": {
    "singularName": "livre",
    "pluralName": "livres",
    "displayName": "Livre",
    "description": "Collection de livres (schema.org/Book)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titre": {
      "type": "string",
      "required": true
    },
    "SousTitre": {
      "type": "string"
    },
    "Slug": {
      "type": "uid",
      "targetField": "Titre",
      "required": true
    },
    "Auteur": {
      "type": "string",
      "required": true
    },
    "Editeur": {
      "type": "string"
    },
    "DatePublication": {
      "type": "date",
      "required": true
    },
    "ISBN": {
      "type": "string"
    },
    "Resume": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
       "required": true
    },
    "Couverture": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "Genre": {
      "type": "string",
      "required": true
    },
    "NombreDePages": {
      "type": "integer",
      "required": true
    },
    "Langue": {
      "type": "string",
      "default": "fr",
      "required": true
    },
    "LienAmazon": {
      "type": "string"
    },
    "LienFnac": {
      "type": "string"
    },
    "LienEditeur": {
      "type": "string"
    },
    "UrlSiteEditeur": {
      "type": "string"
    },
    "Extrait": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "Seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
