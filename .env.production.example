# ======================
# Racine — utilisé par docker-compose.prod.yml (docker compose --env-file .env.production ...)
# ======================
POSTGRES_DB=jm-courtois
POSTGRES_USER=jm-courtois
# Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Propriétaire du repo GitHub (pour ghcr.io/<GHCR_OWNER>/...)
GHCR_OWNER=idefix38
# Tag d'image à déployer (le workflow pousse aussi le SHA du commit)
IMAGE_TAG=latest
# Port loopback sur lequel nginx écoute, à relier depuis le reverse-proxy déjà en place sur le serveur
NGINX_PROD_PORT=8095
