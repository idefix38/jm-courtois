# ======================
# Frontend Next.js — production (frontend/.env.production, jamais commité)
# ======================

# Utilisée aussi comme build-arg Docker (voir .github/workflows/deploy.yml) : valeur publique, pas un secret
NEXT_PUBLIC_STRAPI_URL=https://cms.jm-courtois.com
# Appel serveur à serveur (via le réseau Docker interne), plus rapide et ne passe pas par le reverse-proxy public
STRAPI_API_URL=http://cms:1337

# Token API Strapi de production (à créer dans l'admin Strapi une fois déployé : Settings > API Tokens)
STRAPI_API_TOKEN=

# Doit être strictement identique à la valeur utilisée dans cms/.env.production
PREVIEW_SECRET=

# Resend (envoi d'e-mail du formulaire de contact)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare Turnstile (captcha) — en production, ces clés réelles sont utilisées (voir src/lib/turnstile.ts)
TURNSTILE_API_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager
GTM_CONTAINER_ID=
